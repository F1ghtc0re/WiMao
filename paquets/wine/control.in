Version: @VERSION@
Section: otherosfs
Priority: optional
Architecture: amd64
Depends: libfreetype6, libfontconfig1, libx11-6, libxext6, libxrender1, libxrandr2, libxi6, libxcursor1, libxcomposite1, libxfixes3, libvulkan1, libgnutls30t64, libpulse0@DEPENDANCES@
