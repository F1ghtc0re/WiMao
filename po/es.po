#: crates/wimao-cli/src/cli.rs
msgid "Run Windows audio plugins on Linux with Wine and yabridge"
msgstr "Ejecuta plugins de audio de Windows en Linux con Wine y yabridge"

#: crates/wimao-cli/src/cli.rs
msgid "Language of the messages (default: system language)"
msgstr "Idioma de los mensajes (por defecto: el del sistema)"

#: crates/wimao-cli/src/cli.rs
msgid "Create the Wine environment"
msgstr "Crea el entorno de Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Install a plugin from its installer or archive"
msgstr "Instala un plugin desde su instalador o archivo comprimido"

#: crates/wimao-cli/src/cli.rs
msgid "Installer or archive to install"
msgstr "Instalador o archivo comprimido que se instala"

#: crates/wimao-cli/src/cli.rs
msgid "Open the installer normally instead of running it silently"
msgstr "Abre el instalador normalmente en lugar de ejecutarlo en silencio"

#: crates/wimao-cli/src/cli.rs
msgid "Do not test that the installed plugins open"
msgstr "No comprueba que los plugins instalados se abran"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask before closing the open programs"
msgstr "No pide confirmación antes de cerrar los programas abiertos"

#: crates/wimao-cli/src/cli.rs
msgid "Recognise the type of an installer without running it"
msgstr "Reconoce el tipo de un instalador sin ejecutarlo"

#: crates/wimao-cli/src/cli.rs
msgid "File to examine"
msgstr "Archivo que se examina"

#: crates/wimao-cli/src/cli.rs
msgid "Test that each already bridged plugin opens"
msgstr "Comprueba que se abre cada plugin ya enlazado"

#: crates/wimao-cli/src/cli.rs
msgid "Wine environment to examine (default: WiMao's own)"
msgstr "Entorno de Wine que se examina (por defecto: el de WiMao)"

#: crates/wimao-cli/src/cli.rs
msgid "Look for problems in the Wine environment"
msgstr "Busca fallos en el entorno de Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Repair the problems found by the diagnosis"
msgstr "Repara los fallos encontrados por el diagnóstico"

#: crates/wimao-cli/src/cli.rs
msgid "Restore points of the Wine environment"
msgstr "Puntos de restauración del entorno de Wine"

#: crates/wimao-cli/src/cli.rs
msgid "List the restore points"
msgstr "Lista los puntos de restauración"

#: crates/wimao-cli/src/cli.rs
msgid "Put the environment back in the state of a restore point"
msgstr "Devuelve el entorno al estado de un punto de restauración"

#: crates/wimao-cli/src/cli.rs
msgid "Restore point identifier (see the \"lister\" command)"
msgstr "Identificador del punto de restauración (véase el comando «lister»)"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask for confirmation"
msgstr "No pide confirmación"

#: crates/wimao-cli/src/cli.rs
msgid "Back up the Wine environment to a disk"
msgstr "Guarda una copia del entorno de Wine en un disco"

#: crates/wimao-cli/src/cli.rs
msgid "Destination folder (an external disk, for example)"
msgstr "Carpeta de destino (un disco externo, por ejemplo)"

#: crates/wimao-cli/src/cli.rs
msgid "Restore the Wine environment from a backup"
msgstr "Restaura el entorno de Wine desde una copia de seguridad"

#: crates/wimao-cli/src/cli.rs
msgid "The .sha256 file written by the backup"
msgstr "El archivo .sha256 escrito por la copia de seguridad"

#: crates/wimao-cli/src/cli.rs
msgid "Print an anonymised problem report"
msgstr "Imprime un informe de problema anonimizado"

#: crates/wimao-cli/src/cli.rs
msgid "List the recipes (publisher managers and known plugins)"
msgstr "Lista las recetas (gestores de editores y plugins conocidos)"

#: crates/wimao-cli/src/cli.rs
msgid "Install or open a publisher's manager (Native Access…)"
msgstr "Instala o abre el gestor de un editor (Native Access…)"

#: crates/wimao-cli/src/cli.rs
msgid "Install the manager of a recipe"
msgstr "Instala el gestor de una receta"

#: crates/wimao-cli/src/cli.rs
msgid "Recipe name (see \"recettes\") or its file name without .toml"
msgstr "Nombre de la receta (véase «recettes») o de su archivo sin .toml"

#: crates/wimao-cli/src/cli.rs
msgid "Installer already downloaded (otherwise the recipe downloads it)"
msgstr "Instalador ya descargado (si no, la receta lo descarga)"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask before replacing the program that handles the link"
msgstr ""
"No pide confirmación antes de reemplazar el programa que gestiona el enlace"

#: crates/wimao-cli/src/cli.rs
msgid "Open the manager and watch its installations until it is closed"
msgstr "Abre el gestor y vigila sus instalaciones hasta que se cierre"

#: crates/wimao-cli/src/cli.rs
msgid "Do not test that the plugins installed in the session open"
msgstr "No prueba que se abran los plugins instalados durante la sesión"

#: crates/wimao-cli/src/cli.rs
msgid "List, open or remove the applications added with an installer"
msgstr "Lista, abre o quita las aplicaciones añadidas con un instalador"

#: crates/wimao-cli/src/cli.rs
msgid "List the added applications whose program still exists"
msgstr "Lista las aplicaciones añadidas cuyo programa sigue existiendo"

#: crates/wimao-cli/src/cli.rs
msgid "Open an application and watch its installations until it is closed"
msgstr "Abre una aplicación y vigila sus instalaciones hasta que se cierre"

#: crates/wimao-cli/src/cli.rs
msgid "Application name (see \"application lister\")"
msgstr "Nombre de la aplicación (véase «application lister»)"

#: crates/wimao-cli/src/cli.rs
msgid "Remove an application from the list (nothing is uninstalled)"
msgstr "Quita una aplicación de la lista (no se desinstala nada)"

#: crates/wimao-cli/src/cli.rs
msgid "Show the latest actions (installations, repairs, backups…)"
msgstr ""
"Muestra las últimas acciones (instalaciones, reparaciones, copias de "
"seguridad…)"

#: crates/wimao-cli/src/cli.rs
msgid "Show every action, not only the latest 20"
msgstr "Muestra todas las acciones, no solo las 20 últimas"

#: crates/wimao-cli/src/cli.rs
msgid "Import the existing Wine environment (~/.wine-mao) into WiMao"
msgstr "Importa el entorno Wine existente (~/.wine-mao) en WiMao"

#: crates/wimao-cli/src/cli.rs
msgid "Cancel the last import: the environment goes back to ~/.wine-mao"
msgstr "Cancela la última importación: el entorno vuelve a ~/.wine-mao"

#: crates/wimao-cli/src/cli.rs
msgid "Pass a sign-in link (native-access://…) to the manager in Wine"
msgstr ""
"Pasa un enlace de inicio de sesión (native-access://…) al gestor en Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Link received from the browser"
msgstr "Enlace recibido del navegador"

#: crates/wimao-cli/src/commandes/applications.rs
msgid "an application named {name}"
msgstr "una aplicación llamada {name}"

#: crates/wimao-cli/src/commandes/applications.rs
msgid "No application added"
msgstr "Ninguna aplicación añadida"

#: crates/wimao-cli/src/commandes/applications.rs
msgid "{name} removed from the list; nothing was uninstalled"
msgstr ""
"La aplicación {name} se ha quitado de la lista; no se ha desinstalado nada"

#: crates/wimao-cli/src/commandes/entretien.rs
#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao-cli/src/commandes/mod.rs
#: crates/wimao-cli/src/commandes/restauration.rs
#: crates/wimao-cli/src/commandes/sauvegarde.rs crates/wimao/src/fenetre/mod.rs
#: crates/wimao/src/reparation.rs
msgid "Cancelled: nothing was changed"
msgstr "Cancelado: no se ha cambiado nada"

#: crates/wimao-cli/src/commandes/entretien.rs crates/wimao/src/reparation.rs
msgid "Repair finished"
msgstr "Reparación terminada"

#: crates/wimao-cli/src/commandes/entretien.rs
msgid "Repairing will close these open programs: {programs}. Continue?"
msgstr ""
"La reparación cerrará estos programas abiertos: {programs}. ¿Continuar?"

#: crates/wimao-cli/src/commandes/entretien.rs crates/wimao-core/src/rapport.rs
#: crates/wimao/src/reparation.rs
msgid "No problem found"
msgstr "No se encontró ningún problema"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid "No recipe"
msgstr "Ninguna receta"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "Installed"
msgstr "Instalado"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "Not installed"
msgstr "No instalado"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/operations.rs
msgid "a recipe named {name}"
msgstr "una receta llamada {name}"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "{name} is installed"
msgstr "{name} está instalado"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid "{name} is open: close it when you are done, or press Ctrl+C"
msgstr "{name} está abierto: ciérrelo cuando haya terminado, o pulse Ctrl+C"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao-cli/src/commandes/installation.rs
msgid "Warning:"
msgstr "Atención:"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid ""
"Still running: {programs}. Waiting for them to finish (Ctrl+C again to stop "
"anyway)"
msgstr ""
"Aún en curso: {programs}. Se espera a que terminen (Ctrl+C otra vez para "
"parar igualmente)"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid ""
"An installer may still be running. Waiting for it to finish (Ctrl+C again to "
"stop anyway)"
msgstr ""
"Puede que un instalador siga en curso. Se espera a que termine (Ctrl+C otra "
"vez para parar igualmente)"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao-cli/src/sortie.rs crates/wimao/src/operations.rs
msgid "Error:"
msgstr "Error:"

#: crates/wimao-cli/src/commandes/historique.rs
msgid "No action yet"
msgstr "Todavía no hay ninguna acción"

#: crates/wimao-cli/src/commandes/import.rs
msgid "Import finished: {path} is now a link to the environment of WiMao"
msgstr "Importación terminada: {path} es ahora un enlace al entorno de WiMao"

#: crates/wimao-cli/src/commandes/import.rs
msgid ""
"A copy of the registry and of the yabridgectl settings is kept in {path}"
msgstr ""
"Se guarda una copia del registro y de los ajustes de yabridgectl en {path}"

#: crates/wimao-cli/src/commandes/import.rs
msgid "an import to cancel"
msgstr "una importación que cancelar"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao/src/restaurer.rs
msgid ""
"The import will be cancelled: the environment goes back to {path} and the "
"link is removed."
msgstr ""
"Se cancelará la importación: el entorno vuelve a {path} y se quita el enlace."

#: crates/wimao-cli/src/commandes/import.rs
msgid "Import cancelled"
msgstr "Importación cancelada"

#: crates/wimao-cli/src/commandes/import.rs
msgid "Existing Wine environment found: {path}"
msgstr "Entorno Wine existente encontrado: {path}"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao/src/restaurer.rs
msgid "Size: {size}"
msgstr "Tamaño: {size}"

#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao/src/assistant_fenetre.rs
msgid "{count} plugin found"
msgid_plural "{count} plugins found"
msgstr[0] "{count} plugin encontrado"
msgstr[1] "{count} plugins encontrados"

#: crates/wimao-cli/src/commandes/import.rs
msgid "It will be moved to {path} (nothing is copied)."
msgstr "Se moverá a {path} (no se copia nada)."

#: crates/wimao-cli/src/commandes/import.rs
msgid "A link will be left at {path}, pointing to the new location."
msgstr "Se dejará un enlace en {path}, hacia la nueva ubicación."

#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "Continue?"
msgstr "¿Continuar?"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao-core/src/import.rs
msgid ""
"Wine environment in {path} (a folder with system.reg, user.reg and drive_c)"
msgstr ""
"entorno Wine en {path} (una carpeta con system.reg, user.reg y drive_c)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "The Wine environment is ready"
msgstr "El entorno de Wine está listo"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao-recettes/src/installation.rs
msgid "the file {path} does not exist"
msgstr "el archivo {path} no existe"

#: crates/wimao-cli/src/commandes/installation.rs crates/wimao/src/dialogues.rs
msgid "The link {scheme}:// is handled by {current}. Replace it with WiMao?"
msgstr "El enlace {scheme}:// lo gestiona {current}. ¿Reemplazarlo por WiMao?"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao/src/gestionnaires.rs
msgid "The link {scheme}:// is not relayed to WiMao"
msgstr "El enlace {scheme}:// no lo retransmite WiMao"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao/src/gestionnaires.rs
msgid "The link {scheme}:// is now relayed to WiMao"
msgstr "El enlace {scheme}:// ahora lo retransmite WiMao"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Warning, ignored recipe:"
msgstr "Atención, receta ignorada:"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "{name} (updated)"
msgstr "{name} (actualizado)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid ""
"No new or updated plugin was found (installer exit code {code}): run the "
"command again with --interactif to open the installer normally"
msgstr ""
"No se encontró ningún plugin nuevo ni actualizado (código de salida del "
"instalador: {code}): vuelva a ejecutar la orden con --interactif para abrir "
"el instalador normalmente"

#: crates/wimao-cli/src/commandes/installation.rs
msgid ""
"No new or updated plugin was found: run the command again with --interactif "
"to open the installer normally"
msgstr ""
"No se encontró ningún plugin nuevo ni actualizado: vuelva a ejecutar la "
"orden con --interactif para abrir el instalador normalmente"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "{file}: {type}"
msgstr "{file}: {type}"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Recipe: {name}"
msgstr "Receta: {name}"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Archive (to extract)"
msgstr "Archivo comprimido (para extraer)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Unknown installer"
msgstr "Instalador desconocido"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "installation"
msgstr "instalación"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "repair"
msgstr "reparación"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "No restore point"
msgstr "Ningún punto de restauración"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "outdated"
msgstr "obsoleto"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Unusable restore point (interrupted creation): {path}"
msgstr "Punto de restauración inutilizable (creación interrumpida): {path}"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "restore point {id}"
msgstr "punto de restauración {id}"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "{n} file added since this point will be removed:"
msgid_plural "{n} files added since this point will be removed:"
msgstr[0] "Se eliminará {n} archivo añadido desde este punto:"
msgstr[1] "Se eliminarán {n} archivos añadidos desde este punto:"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Put the environment back in this state?"
msgstr "¿Devolver el entorno a este estado?"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Done: {n} file removed"
msgid_plural "Done: {n} files removed"
msgstr[0] "Hecho: {n} archivo eliminado"
msgstr[1] "Hecho: {n} archivos eliminados"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "{n} broken plugin link removed"
msgid_plural "{n} broken plugin links removed"
msgstr[0] "{n} enlace de plugin roto eliminado"
msgstr[1] "{n} enlaces de plugin rotos eliminados"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "Backup written. To restore it, keep this file: {path}"
msgstr ""
"Copia de seguridad escrita. Para restaurarla, conserve este archivo: {path}"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "the backup file {path} does not exist"
msgstr "el archivo de copia de seguridad {path} no existe"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid ""
"The current environment will be set aside as {path}.ancien-<date> (nothing "
"is deleted), then replaced by the backup."
msgstr ""
"El entorno actual se apartará en {path}.ancien-<date> (no se borra nada) y "
"se sustituirá por la copia de seguridad."

#: crates/wimao-cli/src/commandes/sauvegarde.rs crates/wimao/src/restaurer.rs
msgid "Backup restored"
msgstr "Copia de seguridad restaurada"

#: crates/wimao-cli/src/commandes/verification.rs
msgid "No bridged plugin found for this environment"
msgstr "No se encontró ningún plugin enlazado para este entorno"

#: crates/wimao-cli/src/commandes/verification.rs
msgid "broken link: the Windows plugin no longer exists in the environment"
msgstr "enlace roto: el plugin de Windows ya no existe en el entorno"

#. Un échec d'écriture sur la sortie n'empêche pas de lire la réponse.
#: crates/wimao-cli/src/confirmation.rs
msgid "[y/N]"
msgstr "[s/N]"

#: crates/wimao-cli/src/confirmation.rs
msgid ""
"Wine will be stopped and these open programs will be closed: {programs}. "
"Continue?"
msgstr ""
"Se detendrá Wine y se cerrarán estos programas abiertos: {programs}. "
"¿Continuar?"

#: crates/wimao-core/src/chemins.rs
msgid ""
"home folder: HOME must be set and not empty (WiMao keeps its settings and "
"cache there)"
msgstr ""
"carpeta personal: HOME debe estar definida y no vacía (WiMao guarda allí sus "
"ajustes y su caché)"

#: crates/wimao-core/src/chemins.rs
msgid "{variable} must be an absolute path (it is \"{path}\")"
msgstr "{variable} debe ser una ruta absoluta (vale «{path}»)"

#: crates/wimao-core/src/correctifs/dxvk.rs
msgid "folders {x64}/ and {x32}/ in the extracted DXVK archive ({folder})"
msgstr "carpetas {x64}/ y {x32}/ en el archivo DXVK extraído ({folder})"

#: crates/wimao-core/src/correctifs/dxvk.rs
msgid "Installing DXVK…"
msgstr "Instalando DXVK…"

#: crates/wimao-core/src/correctifs/mono.rs
msgid "Installing Wine Mono…"
msgstr "Instalando Wine Mono…"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "cabextract (install the \"cabextract\" package of your distribution)"
msgstr "cabextract (instale el paquete «cabextract» de su distribución)"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "Unknown Microsoft library version, used anyway: {hash}"
msgstr ""
"Versión desconocida de la biblioteca de Microsoft, usada de todos modos: "
"{hash}"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "{names} in {folder} after cabextract"
msgstr "{names} en {folder} después de cabextract"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "Installing the Microsoft C++ library (msvcp140)…"
msgstr "Instalando la biblioteca C++ de Microsoft (msvcp140)…"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid ""
"cab1.cab of vcRuntimeMinimum in ProgramData/Package Cache after installing "
"the VC++ Redistributable"
msgstr ""
"cab1.cab de vcRuntimeMinimum en ProgramData/Package Cache después de "
"instalar el VC++ Redistributable"

#: crates/wimao-core/src/diagnostic.rs
msgid "The Wine environment does not exist yet"
msgstr "El entorno de Wine todavía no existe"

#: crates/wimao-core/src/diagnostic.rs
msgid "Wine Mono (.NET support) is not installed"
msgstr "Wine Mono (compatibilidad con .NET) no está instalado"

#: crates/wimao-core/src/diagnostic.rs
msgid "DXVK (graphics libraries) is not installed"
msgstr "DXVK (bibliotecas gráficas) no está instalado"

#: crates/wimao-core/src/diagnostic.rs
msgid "The Microsoft msvcp140 library is not installed"
msgstr "La biblioteca msvcp140 de Microsoft no está instalada"

#: crates/wimao-core/src/diagnostic.rs
msgid "{n} plugin is not bridged to Linux yet"
msgid_plural "{n} plugins are not bridged to Linux yet"
msgstr[0] "{n} plugin aún no está conectado a Linux"
msgstr[1] "{n} plugins aún no están conectados a Linux"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"Wine seems stuck: its server is running but no plugin or installation uses it"
msgstr ""
"Wine parece bloqueado: su servidor está en marcha pero ningún plugin ni "
"instalación lo usa"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"Some folders of the Wine environment (Documents, Desktop…) lead to your "
"personal folders: installers would fill them"
msgstr ""
"Algunas carpetas del entorno Wine (Documentos, Escritorio…) llevan a sus "
"carpetas personales: los instaladores las llenarían"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"{app} (Flatpak) cannot see {folders}, so your bridged plugins will not load "
"in it. To let it, run: {command}"
msgstr ""
"{app} (Flatpak) no ve {folders}: sus plugins puenteados no se cargarán en "
"él. Para permitírselo, ejecute: {command}"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software use another yabridge than WiMao's: {link} "
"leads to {current}, not to {expected}. To use WiMao's, run: {command}"
msgstr ""
"Los plugins de su software de música usan otro yabridge distinto del de "
"WiMao: {link} lleva a {current} y no a {expected}. Para usar el de WiMao, "
"ejecute: {command}"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software cannot find yabridge: {link} leads to "
"{current}, which no longer exists. To use WiMao's ({expected}), run: "
"{command}"
msgstr ""
"Los plugins de su software de música no encuentran yabridge: {link} lleva a "
"{current}, que ya no existe. Para usar el de WiMao ({expected}), ejecute: "
"{command}"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software use the yabridge in the folder {link}, "
"not WiMao's ({expected}). To use WiMao's, move that folder away, then run: "
"{command}"
msgstr ""
"Los plugins de su software de música usan el yabridge de la carpeta {link}, "
"y no el de WiMao ({expected}). Para usar el de WiMao, mueva esa carpeta a "
"otro sitio y ejecute: {command}"

#: crates/wimao-core/src/diagnostic.rs
