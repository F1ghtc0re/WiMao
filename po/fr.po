#: crates/wimao-cli/src/cli.rs
msgid "Run Windows audio plugins on Linux with Wine and yabridge"
msgstr ""
"Fait tourner des plugins audio Windows sous Linux avec Wine et yabridge"

#: crates/wimao-cli/src/cli.rs
msgid "Language of the messages (default: system language)"
msgstr "Langue des messages (par défaut : celle du système)"

#: crates/wimao-cli/src/cli.rs
msgid "Create the Wine environment"
msgstr "Crée l'environnement Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Install a plugin from its installer or archive"
msgstr "Installe un plugin depuis son installeur ou son archive"

#: crates/wimao-cli/src/cli.rs
msgid "Installer or archive to install"
msgstr "Installeur ou archive à installer"

#: crates/wimao-cli/src/cli.rs
msgid "Open the installer normally instead of running it silently"
msgstr "Ouvre l'installeur normalement au lieu de le lancer en silence"

#: crates/wimao-cli/src/cli.rs
msgid "Do not test that the installed plugins open"
msgstr "Ne teste pas l'ouverture des plugins installés"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask before closing the open programs"
msgstr "Ne demande pas confirmation avant de fermer les programmes ouverts"

#: crates/wimao-cli/src/cli.rs
msgid "Recognise the type of an installer without running it"
msgstr "Reconnaît le type d'un installeur sans le lancer"

#: crates/wimao-cli/src/cli.rs
msgid "File to examine"
msgstr "Fichier à examiner"

#: crates/wimao-cli/src/cli.rs
msgid "Test that each already bridged plugin opens"
msgstr "Teste l'ouverture de chaque plugin déjà ponté"

#: crates/wimao-cli/src/cli.rs
msgid "Wine environment to examine (default: WiMao's own)"
msgstr "Environnement Wine à examiner (par défaut : celui de WiMao)"

#: crates/wimao-cli/src/cli.rs
msgid "Look for problems in the Wine environment"
msgstr "Cherche les défauts de l'environnement Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Repair the problems found by the diagnosis"
msgstr "Répare les défauts trouvés par le diagnostic"

#: crates/wimao-cli/src/cli.rs
msgid "Restore points of the Wine environment"
msgstr "Points de restauration de l'environnement Wine"

#: crates/wimao-cli/src/cli.rs
msgid "List the restore points"
msgstr "Liste les points de restauration"

#: crates/wimao-cli/src/cli.rs
msgid "Put the environment back in the state of a restore point"
msgstr "Remet l'environnement dans l'état d'un point de restauration"

#: crates/wimao-cli/src/cli.rs
msgid "Restore point identifier (see the \"lister\" command)"
msgstr "Identifiant du point de restauration (voir la commande « lister »)"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask for confirmation"
msgstr "Ne demande pas confirmation"

#: crates/wimao-cli/src/cli.rs
msgid "Back up the Wine environment to a disk"
msgstr "Sauvegarde l'environnement Wine sur un disque"

#: crates/wimao-cli/src/cli.rs
msgid "Destination folder (an external disk, for example)"
msgstr "Dossier de destination (un disque externe, par exemple)"

#: crates/wimao-cli/src/cli.rs
msgid "Restore the Wine environment from a backup"
msgstr "Restaure l'environnement Wine depuis une sauvegarde"

#: crates/wimao-cli/src/cli.rs
msgid "The .sha256 file written by the backup"
msgstr "Le fichier .sha256 écrit par la sauvegarde"

#: crates/wimao-cli/src/cli.rs
msgid "Print an anonymised problem report"
msgstr "Imprime un rapport de problème anonymisé"

#: crates/wimao-cli/src/cli.rs
msgid "List the recipes (publisher managers and known plugins)"
msgstr "Liste les recettes (gestionnaires d'éditeurs et plugins connus)"

#: crates/wimao-cli/src/cli.rs
msgid "Install or open a publisher's manager (Native Access…)"
msgstr "Installe ou ouvre le gestionnaire d'un éditeur (Native Access…)"

#: crates/wimao-cli/src/cli.rs
msgid "Install the manager of a recipe"
msgstr "Installe le gestionnaire d'une recette"

#: crates/wimao-cli/src/cli.rs
msgid "Recipe name (see \"recettes\") or its file name without .toml"
msgstr "Nom de la recette (voir « recettes ») ou de son fichier sans .toml"

#: crates/wimao-cli/src/cli.rs
msgid "Installer already downloaded (otherwise the recipe downloads it)"
msgstr "Installeur déjà téléchargé (sinon la recette le télécharge)"

#: crates/wimao-cli/src/cli.rs
msgid "Do not ask before replacing the program that handles the link"
msgstr ""
"Ne demande pas confirmation avant de remplacer le programme qui gère le lien"

#: crates/wimao-cli/src/cli.rs
msgid "Open the manager and watch its installations until it is closed"
msgstr ""
"Ouvre le gestionnaire et surveille ses installations jusqu'à sa fermeture"

#: crates/wimao-cli/src/cli.rs
msgid "Do not test that the plugins installed in the session open"
msgstr "Ne teste pas l'ouverture des plugins installés pendant la session"

#: crates/wimao-cli/src/cli.rs
msgid "Show the latest actions (installations, repairs, backups…)"
msgstr ""
"Affiche les dernières actions (installations, réparations, sauvegardes…)"

#: crates/wimao-cli/src/cli.rs
msgid "Show every action, not only the latest 20"
msgstr "Affiche toutes les actions, pas seulement les 20 dernières"

#: crates/wimao-cli/src/cli.rs
msgid "Import the existing Wine environment (~/.wine-mao) into WiMao"
msgstr "Importe l'environnement Wine existant (~/.wine-mao) dans WiMao"

#: crates/wimao-cli/src/cli.rs
msgid "Cancel the last import: the environment goes back to ~/.wine-mao"
msgstr "Annule le dernier import : l'environnement retourne dans ~/.wine-mao"

#: crates/wimao-cli/src/cli.rs
msgid "Pass a sign-in link (native-access://…) to the manager in Wine"
msgstr ""
"Transmet un lien de connexion (native-access://…) au gestionnaire dans Wine"

#: crates/wimao-cli/src/cli.rs
msgid "Link received from the browser"
msgstr "Lien reçu du navigateur"

#: crates/wimao-cli/src/commandes/entretien.rs
#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao-cli/src/commandes/mod.rs
#: crates/wimao-cli/src/commandes/restauration.rs
#: crates/wimao-cli/src/commandes/sauvegarde.rs crates/wimao/src/fenetre/mod.rs
#: crates/wimao/src/reparation.rs
msgid "Cancelled: nothing was changed"
msgstr "Annulé : rien n'a été modifié"

#: crates/wimao-cli/src/commandes/entretien.rs crates/wimao/src/reparation.rs
msgid "Repair finished"
msgstr "Réparation terminée"

#: crates/wimao-cli/src/commandes/entretien.rs
msgid "Repairing will close these open programs: {programs}. Continue?"
msgstr "La réparation fermera ces programmes ouverts : {programs}. Continuer ?"

#: crates/wimao-cli/src/commandes/entretien.rs crates/wimao-core/src/rapport.rs
#: crates/wimao/src/reparation.rs
msgid "No problem found"
msgstr "Aucun problème détecté"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid "No recipe"
msgstr "Aucune recette"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "Installed"
msgstr "Installé"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "Not installed"
msgstr "Non installé"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/operations.rs
msgid "a recipe named {name}"
msgstr "une recette nommée {name}"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao/src/gestionnaires.rs
msgid "{name} is installed"
msgstr "{name} est installé"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid "{name} is open: close it when you are done, or press Ctrl+C"
msgstr ""
"{name} est ouvert : fermez-le quand vous avez fini, ou appuyez sur Ctrl+C"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao-cli/src/commandes/installation.rs
msgid "Warning:"
msgstr "Attention :"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid ""
"Still running: {programs}. Waiting for them to finish (Ctrl+C again to stop "
"anyway)"
msgstr ""
"Encore en cours : {programs}. On attend qu'ils finissent (Ctrl+C encore pour "
"arrêter quand même)"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
msgid ""
"An installer may still be running. Waiting for it to finish (Ctrl+C again to "
"stop anyway)"
msgstr ""
"Un installeur tourne peut-être encore. On attend qu'il finisse (Ctrl+C "
"encore pour arrêter quand même)"

#: crates/wimao-cli/src/commandes/gestionnaires.rs
#: crates/wimao-cli/src/sortie.rs crates/wimao/src/operations.rs
msgid "Error:"
msgstr "Erreur :"

#: crates/wimao-cli/src/commandes/historique.rs
msgid "No action yet"
msgstr "Aucune action pour le moment"

#: crates/wimao-cli/src/commandes/import.rs
msgid "Import finished: {path} is now a link to the environment of WiMao"
msgstr ""
"Import terminé : {path} est maintenant un lien vers l'environnement de WiMao"

#: crates/wimao-cli/src/commandes/import.rs
msgid ""
"A copy of the registry and of the yabridgectl settings is kept in {path}"
msgstr ""
"Une copie du registre et des réglages de yabridgectl est gardée dans {path}"

#: crates/wimao-cli/src/commandes/import.rs
msgid "an import to cancel"
msgstr "un import à annuler"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao/src/restaurer.rs
msgid ""
"The import will be cancelled: the environment goes back to {path} and the "
"link is removed."
msgstr ""
"L'import va être annulé : l'environnement retourne dans {path} et le lien "
"est retiré."

#: crates/wimao-cli/src/commandes/import.rs
msgid "Import cancelled"
msgstr "Import annulé"

#: crates/wimao-cli/src/commandes/import.rs
msgid "Existing Wine environment found: {path}"
msgstr "Environnement Wine existant trouvé : {path}"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao/src/restaurer.rs
msgid "Size: {size}"
msgstr "Taille : {size}"

#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao/src/assistant_fenetre.rs
msgid "{count} plugin found"
msgid_plural "{count} plugins found"
msgstr[0] "{count} plugin trouvé"
msgstr[1] "{count} plugins trouvés"

#: crates/wimao-cli/src/commandes/import.rs
msgid "It will be moved to {path} (nothing is copied)."
msgstr "Il sera déplacé vers {path} (rien n'est copié)."

#: crates/wimao-cli/src/commandes/import.rs
msgid "A link will be left at {path}, pointing to the new location."
msgstr "Un lien sera laissé dans {path}, vers le nouvel emplacement."

#: crates/wimao-cli/src/commandes/import.rs
#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "Continue?"
msgstr "Continuer ?"

#: crates/wimao-cli/src/commandes/import.rs crates/wimao-core/src/import.rs
msgid ""
"Wine environment in {path} (a folder with system.reg, user.reg and drive_c)"
msgstr ""
"environnement Wine dans {path} (un dossier avec system.reg, user.reg et "
"drive_c)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "The Wine environment is ready"
msgstr "L'environnement Wine est prêt"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao-recettes/src/installation.rs
msgid "the file {path} does not exist"
msgstr "le fichier {path} n'existe pas"

#: crates/wimao-cli/src/commandes/installation.rs crates/wimao/src/dialogues.rs
msgid "The link {scheme}:// is handled by {current}. Replace it with WiMao?"
msgstr "Le lien {scheme}:// est géré par {current}. Le remplacer par WiMao ?"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao/src/gestionnaires.rs
msgid "The link {scheme}:// is not relayed to WiMao"
msgstr "Le lien {scheme}:// n'est pas relayé par WiMao"

#: crates/wimao-cli/src/commandes/installation.rs
#: crates/wimao/src/gestionnaires.rs
msgid "The link {scheme}:// is now relayed to WiMao"
msgstr "Le lien {scheme}:// est maintenant relayé par WiMao"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Warning, ignored recipe:"
msgstr "Attention, recette ignorée :"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "{name} (updated)"
msgstr "{name} (mis à jour)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid ""
"No new or updated plugin was found (installer exit code {code}): run the "
"command again with --interactif to open the installer normally"
msgstr ""
"Aucun plugin nouveau ni mis à jour (code de sortie de l'installeur : "
"{code}) : relancez la commande avec --interactif pour ouvrir l'installeur "
"normalement"

#: crates/wimao-cli/src/commandes/installation.rs
msgid ""
"No new or updated plugin was found: run the command again with --interactif "
"to open the installer normally"
msgstr ""
"Aucun plugin nouveau ni mis à jour : relancez la commande avec --interactif "
"pour ouvrir l'installeur normalement"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "{file}: {type}"
msgstr "{file} : {type}"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Recipe: {name}"
msgstr "Recette : {name}"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Archive (to extract)"
msgstr "Archive (à extraire)"

#: crates/wimao-cli/src/commandes/installation.rs
msgid "Unknown installer"
msgstr "Installeur inconnu"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "installation"
msgstr "installation"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "repair"
msgstr "réparation"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "No restore point"
msgstr "Aucun point de restauration"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "outdated"
msgstr "périmé"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Unusable restore point (interrupted creation): {path}"
msgstr "Point de restauration inutilisable (création interrompue) : {path}"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "restore point {id}"
msgstr "point de restauration {id}"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "{n} file added since this point will be removed:"
msgid_plural "{n} files added since this point will be removed:"
msgstr[0] "{n} fichier ajouté depuis ce point sera supprimé :"
msgstr[1] "{n} fichiers ajoutés depuis ce point seront supprimés :"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Put the environment back in this state?"
msgstr "Remettre l'environnement dans cet état ?"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "Done: {n} file removed"
msgid_plural "Done: {n} files removed"
msgstr[0] "Terminé : {n} fichier supprimé"
msgstr[1] "Terminé : {n} fichiers supprimés"

#: crates/wimao-cli/src/commandes/restauration.rs
msgid "{n} broken plugin link removed"
msgid_plural "{n} broken plugin links removed"
msgstr[0] "{n} lien de plugin cassé retiré"
msgstr[1] "{n} liens de plugin cassés retirés"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "Backup written. To restore it, keep this file: {path}"
msgstr "Sauvegarde écrite. Pour la restaurer, gardez ce fichier : {path}"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid "the backup file {path} does not exist"
msgstr "le fichier de sauvegarde {path} n'existe pas"

#: crates/wimao-cli/src/commandes/sauvegarde.rs
msgid ""
"The current environment will be set aside as {path}.ancien-<date> (nothing "
"is deleted), then replaced by the backup."
msgstr ""
"L'environnement actuel sera mis de côté dans {path}.ancien-<date> (rien "
"n'est supprimé), puis remplacé par la sauvegarde."

#: crates/wimao-cli/src/commandes/sauvegarde.rs crates/wimao/src/restaurer.rs
msgid "Backup restored"
msgstr "Sauvegarde restaurée"

#: crates/wimao-cli/src/commandes/verification.rs
msgid "No bridged plugin found for this environment"
msgstr "Aucun plugin ponté trouvé pour cet environnement"

#: crates/wimao-cli/src/commandes/verification.rs
msgid "broken link: the Windows plugin no longer exists in the environment"
msgstr "lien cassé : le plugin Windows n'existe plus dans l'environnement"

#. Un échec d'écriture sur la sortie n'empêche pas de lire la réponse.
#: crates/wimao-cli/src/confirmation.rs
msgid "[y/N]"
msgstr "[o/N]"

#: crates/wimao-cli/src/confirmation.rs
msgid ""
"Wine will be stopped and these open programs will be closed: {programs}. "
"Continue?"
msgstr ""
"Wine sera arrêté et ces programmes ouverts seront fermés : {programs}. "
"Continuer ?"

#: crates/wimao-core/src/chemins.rs
msgid ""
"home folder: HOME must be set and not empty (WiMao keeps its settings and "
"cache there)"
msgstr ""
"dossier personnel : HOME doit être défini et non vide (WiMao y range ses "
"réglages et son cache)"

#: crates/wimao-core/src/chemins.rs
msgid "{variable} must be an absolute path (it is \"{path}\")"
msgstr "{variable} doit être un chemin absolu (il vaut « {path} »)"

#: crates/wimao-core/src/correctifs/dxvk.rs
msgid "folders {x64}/ and {x32}/ in the extracted DXVK archive ({folder})"
msgstr "dossiers {x64}/ et {x32}/ dans l'archive DXVK extraite ({folder})"

#: crates/wimao-core/src/correctifs/dxvk.rs
msgid "Installing DXVK…"
msgstr "Installation de DXVK…"

#: crates/wimao-core/src/correctifs/mono.rs
msgid "Installing Wine Mono…"
msgstr "Installation de Wine Mono…"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "cabextract (install the \"cabextract\" package of your distribution)"
msgstr "cabextract (installez le paquet « cabextract » de votre distribution)"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "Unknown Microsoft library version, used anyway: {hash}"
msgstr ""
"Version inconnue de la bibliothèque Microsoft, utilisée quand même : {hash}"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "{names} in {folder} after cabextract"
msgstr "{names} dans {folder} après cabextract"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid "Installing the Microsoft C++ library (msvcp140)…"
msgstr "Installation de la bibliothèque C++ de Microsoft (msvcp140)…"

#: crates/wimao-core/src/correctifs/msvcp.rs
msgid ""
"cab1.cab of vcRuntimeMinimum in ProgramData/Package Cache after installing "
"the VC++ Redistributable"
msgstr ""
"cab1.cab de vcRuntimeMinimum dans ProgramData/Package Cache après "
"l'installation du VC++ Redistributable"

#: crates/wimao-core/src/diagnostic.rs
msgid "The Wine environment does not exist yet"
msgstr "L'environnement Wine n'existe pas encore"

#: crates/wimao-core/src/diagnostic.rs
msgid "Wine Mono (.NET support) is not installed"
msgstr "Wine Mono (prise en charge de .NET) n'est pas installé"

#: crates/wimao-core/src/diagnostic.rs
msgid "DXVK (graphics libraries) is not installed"
msgstr "DXVK (bibliothèques graphiques) n'est pas installé"

#: crates/wimao-core/src/diagnostic.rs
msgid "The Microsoft msvcp140 library is not installed"
msgstr "La bibliothèque Microsoft msvcp140 n'est pas installée"

#: crates/wimao-core/src/diagnostic.rs
msgid "{n} plugin is not bridged to Linux yet"
msgid_plural "{n} plugins are not bridged to Linux yet"
msgstr[0] "{n} plugin n'est pas encore relié à Linux"
msgstr[1] "{n} plugins ne sont pas encore reliés à Linux"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"Wine seems stuck: its server is running but no plugin or installation uses it"
msgstr ""
"Wine semble bloqué : son serveur tourne mais aucun plugin ni aucune "
"installation ne l'utilise"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"Some folders of the Wine environment (Documents, Desktop…) lead to your "
"personal folders: installers would fill them"
msgstr ""
"Des dossiers de l'environnement Wine (Documents, Bureau…) mènent à vos "
"dossiers personnels : les installeurs les rempliraient"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software use another yabridge than WiMao's: {link} "
"leads to {current}, not to {expected}. To use WiMao's, run: ln -sfn "
"{expected_sh} {link_sh}"
msgstr ""
"Les plugins de votre logiciel de musique utilisent un autre yabridge que "
"celui de WiMao : {link} mène à {current} et non à {expected}. Pour utiliser "
"celui de WiMao, lancez : ln -sfn {expected_sh} {link_sh}"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software cannot find yabridge: {link} leads to "
"{current}, which no longer exists. To use WiMao's ({expected}), run: ln -sfn "
"{expected_sh} {link_sh}"
msgstr ""
"Les plugins de votre logiciel de musique ne trouvent pas yabridge : {link} "
"mène à {current}, qui n'existe plus. Pour utiliser celui de WiMao "
"({expected}), lancez : ln -sfn {expected_sh} {link_sh}"

#: crates/wimao-core/src/diagnostic.rs
msgid ""
"The plugins in your music software use the yabridge in the folder {link}, "
"not WiMao's ({expected}). To use WiMao's, move that folder away, then run: "
"ln -s {expected_sh} {link_sh}"
msgstr ""
"Les plugins de votre logiciel de musique utilisent le yabridge du dossier "
"{link}, et non celui de WiMao ({expected}). Pour utiliser celui de WiMao, "
"déplacez ce dossier ailleurs, puis lancez : ln -s {expected_sh} {link_sh}"

#: crates/wimao-core/src/diagnostic.rs
#: crates/wimao-recettes/src/gestionnaire.rs
#: crates/wimao-recettes/src/installation.rs
msgid "Creating a restore point…"
msgstr "Création d'un point de restauration…"

#: crates/wimao-core/src/diagnostic.rs crates/wimao/src/aide.rs
#: crates/wimao/src/dialogues.rs crates/wimao/src/fenetre/mod.rs
#: crates/wimao/src/reparation.rs
msgid "Repair"
msgstr "Réparer"

#: crates/wimao-core/src/diagnostic.rs
msgid "Stopping Wine"
msgstr "Arrêt de Wine"

#: crates/wimao-core/src/diagnostic.rs
msgid "Repairing: {problem}"
msgstr "Réparation : {problem}"

#: crates/wimao-core/src/environnement.rs
msgid "Wine environment"
msgstr "Environnement Wine"

#: crates/wimao-core/src/environnement.rs
msgid "Creating the Wine environment…"
msgstr "Création de l'environnement Wine…"

#: crates/wimao-core/src/environnement.rs
msgid "Already done: {name}"
msgstr "Déjà fait : {name}"

#: crates/wimao-core/src/erreur.rs
msgid ""
"the command \"{program}\" failed (code {code}):\n"
"{output}"
msgstr ""
"la commande « {program} » a échoué (code {code}) :\n"
"{output}"

#: crates/wimao-core/src/erreur.rs
